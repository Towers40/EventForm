# Frontend (Vite)
VITE_API_URL=http://localhost:3001

# URL web pública (para la app nativa: enlaces compartidos + base del API).
# En builds nativos, si VITE_API_URL está vacío se usa esta URL.
VITE_PUBLIC_URL=https://event-form-navy.vercel.app

# Imágenes (Cloudinary, subida unsigned desde el cliente). Si faltan, las
# imágenes se guardan en base64 (comportamiento anterior).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Correo transaccional (Resend). Si RESEND_API_KEY existe, se usa Resend en
# lugar de SMTP. RESEND_FROM debe ser un remitente de tu dominio verificado.
RESEND_API_KEY=
RESEND_FROM=EventForm <noreply@tudominio.com>

# API Server
PORT=3001
JWT_SECRET=genera-un-secreto-largo-aleatorio
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Super administrador (ejecutar: cd server && npm run seed)
SUPER_ADMIN_EMAIL=admin@eventform.co
SUPER_ADMIN_PASSWORD=cambiar-esta-clave
SUPER_ADMIN_NAME=Dueño EventForm

# Producción: carpeta persistente para SQLite (Railway volume, etc.)
# DATA_DIR=/data
