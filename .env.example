# Frontend (Vite)
# VITE_API_URL solo se usa en la app NATIVA (Capacitor). En web NO debe
# definirse en Vercel: el frontend y el API viven en el mismo dominio, así que
# se usan rutas relativas (/api). En desarrollo local el proxy de Vite ya
# enruta /api → localhost:3001, por lo que tampoco es necesaria.
# ⚠️ Fijar VITE_API_URL a una URL absoluta en Vercel rompe los dominios de
# preview (login cross-origin + redirect en el preflight de CORS).
# VITE_API_URL=http://localhost:3001

# URL web pública (para la app nativa: enlaces compartidos + base del API).
# En builds nativos, si VITE_API_URL está vacío se usa esta URL.
VITE_PUBLIC_URL=https://event-form-navy.vercel.app

# Imágenes (Cloudinary, subida unsigned desde el cliente). Si faltan, las
# imágenes se guardan en base64 (comportamiento anterior).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Cloudinary del lado servidor (mismos valores que los VITE_, sin ese prefijo).
# Se usan para: (1) convertir el avatar a URL al guardarlo, así ningún avatar
# nuevo entra como base64; (2) el script de migración `npm run migrate:avatars`.
# Si faltan, el avatar se guarda como base64 (sin regresión).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ── Correo transaccional ──────────────────────────────────────────────────────
# La app envía por Resend (si hay RESEND_API_KEY) o, si no, por SMTP (Gmail).
# El remitente que ve el usuario es "TapIn <cuenta-autenticada>".

# Opción A — Gmail SMTP (la que usa TapIn hoy). La cuenta es tapinwalletcol@gmail.com.
# SMTP_PASS NO es la contraseña normal: es una "Contraseña de aplicación" de
# Google (requiere activar la verificación en 2 pasos en esa cuenta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tapinwalletcol@gmail.com
SMTP_PASS=
EMAIL_FROM=tapinwalletcol@gmail.com

# Opción B — Resend (preferido si algún día usas dominio propio). RESEND_FROM
# debe ser un remitente de tu dominio verificado.
RESEND_API_KEY=
RESEND_FROM=TapIn <noreply@tudominio.com>

# API Server
PORT=3001
JWT_SECRET=genera-un-secreto-largo-aleatorio
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Super administrador (ejecutar: cd server && npm run seed)
SUPER_ADMIN_EMAIL=admin@tapin.co
SUPER_ADMIN_PASSWORD=cambiar-esta-clave
SUPER_ADMIN_NAME=Dueño EventForm

# Producción: carpeta persistente para SQLite (Railway volume, etc.)
# DATA_DIR=/data
